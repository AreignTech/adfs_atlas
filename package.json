{
  "name": "atlas",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "api:dev": "dotnet run --project backend/Atlas.Api --launch-profile Atlas.Api",
    "api:build": "dotnet build backend/Atlas.slnx -m:1",
    "api:types": "openapi-typescript http://127.0.0.1:5080/openapi/v1.json -o src/lib/api/generated.ts",
    "db:migrate": "dotnet run --project backend/Atlas.DbTool -- migrate",
    "db:seed": "dotnet run --project backend/Atlas.DbTool -- seed",
    "db:verify": "dotnet run --project backend/Atlas.DbTool -- verify-schema",
    "test:backend": "pwsh -NoProfile -File scripts/test-backend.ps1"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@scalar/api-reference-react": "^0.9.95",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.29",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.3",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
