# `pnpm db:docker:up` generates local-only credentials and writes them to .env.local.
POSTGRES_USER="flowboard"
POSTGRES_PASSWORD="generate-on-first-run"
POSTGRES_DB="flowboard"
POSTGRES_PORT="5433"
DEMO_USER_PASSWORD="P@ssword1"
DATABASE_URL="postgresql://flowboard:generate-on-first-run@localhost:5433/flowboard"

BETTER_AUTH_SECRET="generate-on-first-run"
BETTER_AUTH_URL="http://localhost:3000"
LDAP_CONFIG_ENCRYPTION_KEY="generate-a-long-random-value"
LDAP_ADMIN_EMAIL="nathan@aol.com"
