{
  "Atlas": {
    "FrontendOrigin": "http://localhost:3000",
    "CookieName": "atlas.session_token",
    "SessionDays": 7,
    "AllowSelfRegistration": false,
    "RequireHttps": true
  },
  "Ldap": {
    "EncryptionKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
