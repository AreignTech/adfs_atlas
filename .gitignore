# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.next-playwright/
/out/

# production
/build
/.backups/
/backend/source-copy-volume.txt

# .NET build outputs and local diagnostics
/backend/**/bin/
/backend/**/obj/
/backend/*-diagnostic.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local deployment configuration and DPAPI-protected secrets
/deploy_scripts/deployment.*.json
!/deploy_scripts/deployment.example.json
/deploy_scripts/*.clixml
/deploy_scripts/*.pfx
